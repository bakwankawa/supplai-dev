# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (export script)
__pycache__/
*.pyc
.pytest_cache/

# ssh keys / credentials — an SSH private key was committed here once. It was
# generated with `ssh-keygen -f id_ed25519.pub`, and -f names the PRIVATE key
# file, so the secret was written to a path whose .pub name looked harmless.
# Match on the id_* stem, not on the suffix.
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
*service-account*.json
*serviceaccount*.json

# SDD scratch workspace — never ship
.superpowers/
